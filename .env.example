# Server only. Copy to .env.local for npm run dev; configure separately on the host.
FEEDBACK_BOT_EMAIL=
FEEDBACK_BOT_PASSWORD=
# The bot must be assigned to exactly one project named "Ta Befäl" and that project's
# active app must use https://befael.vercel.app. No IDs are needed for this setup.
# Optional overrides for other project names or an explicit project/app ID:
FEEDBACK_PROJECT_NAME=Ta Befäl
FEEDBACK_PROJECT_ID=
FEEDBACK_APP_ID=
# Use the staging API for development/preview credentials if available.
FEEDBACK_API_URL=https://ws.cyberschooling.eu/feedback/api/v1
